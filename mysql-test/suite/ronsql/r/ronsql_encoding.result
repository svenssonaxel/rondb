===== Test encoding in TSV mode =====
== Query ==
SELECT title
, t_greek
, t_latin1
, t_utf16
, t_utf8mb4
, count(*)
FROM encoding_test
GROUP BY title
, t_greek
, t_latin1
, t_utf16
, t_utf8mb4
;

